# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL, used in emails and permanent links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: email notifications through Resend (FR5). Without these, emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM="Yoruba Archives <notifications@your-domain.com>"

# Used only by `npm run seed` to set the demo accounts' password
SEED_PASSWORD=

# Preview with sample archive data and no database (remove once Supabase is linked)
DEMO_MODE=
